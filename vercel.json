{
  "version": 2,
  "builds": [
    {
      "src": "api/billing.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/ai.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/analyze-image.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/blog.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/contact.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/fertilizer-planner.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/knowledge-base.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/otp.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/sitemap.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/stats.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/upload-image.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/weather.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "outputDirectory": "build"
      }
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://hefnoplant.site/$1",
      "statusCode": 301,
      "has": [
        {
          "type": "host",
          "value": "www.hefnoplant.site"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/blog/(.*)",
      "dest": "api/blog.js"
    },
    {
      "src": "/sitemap.xml",
      "dest": "api/sitemap.js"
    },
    {
      "src": "/api/(create-checkout-session|stripe-webhook|check-quota|check-expired|subscription|vodafone-cash/initiate|vodafone-cash/verify|paymob/intent|paymob/webhook|paymob/payments|billing)(/.*)?",
      "dest": "api/billing.js"
    },
    {
      "src": "/api/([^/]+)",
      "dest": "api/$1.js"
    },
    {
      "src": "/api/otp/(send|verify)",
      "dest": "api/otp.js"
    },
    {
      "src": "/api/send-otp",
      "dest": "api/otp.js"
    },
    {
      "src": "/api/verify-otp",
      "dest": "api/otp.js"
    },
    {
      "src": "/(.*)",
      "dest": "api/blog.js",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Twitterbot|facebookexternalhit|LinkedInBot|WhatsApp|TelegramBot|Discordbot|Slack|Discourse|Facebot).*"
        }
      ]
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}